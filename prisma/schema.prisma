generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  // Lowercase handle for finding people in-app. Null until claimed; sign-in
  // stays on email, so this is identity-for-others, not authentication.
  username       String?  @unique
  displayName    String?
  timezone       String   @default("America/Los_Angeles")
  // How this person prefers to be spoken TO. Read by the compose route from
  // the receiver's record and passed to the AI layer.
  tonePreference String   @default("warm_and_gentle")
  sessionDays    Int      @default(30)
  // UI language — BCP-47 tag (e.g. "en", "zh-CN"). Used for interface
  // strings and the language the AI responds in when rephrasing.
  locale         String   @default("en")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  statusText      String?
  statusMood      String?
  statusUpdatedAt DateTime?

  sentConnections      Connection[]       @relation("UserA")
  receivedConnections  Connection[]       @relation("UserB")
  requestedConnections Connection[]       @relation("RequestedBy")
  sentMessages         Message[]          @relation("Sender")
  topicSettings        TopicSetting[]
  topicDefaults        TopicDefault[]
  magicTokens          MagicToken[]
  sentInvites          MagicToken[]       @relation("InvitedBy")
  knowMeEntries        KnowMeEntry[]
  practiceSessions     PracticeSession[]
  wallPosts            WallPost[]
  connectionPrefs      ConnectionPreference[]
}

model MagicToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  // The account this token signs in (resolved from the recipient address).
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  // For purpose="invite": who sent the invitation. Kept separate from userId —
  // conflating the two made every invite either fail or self-connect.
  invitedByUserId String?
  invitedBy       User?  @relation("InvitedBy", fields: [invitedByUserId], references: [id])
  email     String
  purpose   String
  consumed  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Connection {
  id               String   @id @default(cuid())
  userAId          String
  userA            User     @relation("UserA", fields: [userAId], references: [id])
  userBId          String
  userB            User     @relation("UserB", fields: [userBId], references: [id])
  // Who initiated, so a pending row renders as "sent" on one side and
  // "accept/decline" on the other. Null on rows older than circle requests.
  requestedById    String?
  requestedBy      User?    @relation("RequestedBy", fields: [requestedById], references: [id])
  relationshipType String   @default("spouse")
  status           String   @default("pending")
  createdAt        DateTime @default(now())

  messages      Message[]
  topicSettings TopicSetting[]
  preferences   ConnectionPreference[]

  @@unique([userAId, userBId])
}

// Per-connection overrides for how a user wants messages from a specific
// contact to be tuned. Falls back to User.tonePreference when absent.
model ConnectionPreference {
  id             String     @id @default(cuid())
  connectionId   String
  connection     Connection @relation(fields: [connectionId], references: [id])
  userId         String
  user           User       @relation(fields: [userId], references: [id])
  tonePreference String     @default("warm_and_gentle")
  // Free-text extra tuning the AI applies on top of the structured tone,
  // e.g. "avoid work talk after 6pm" or "my mother-in-law is a sore spot".
  tonePrompt     String?

  @@unique([connectionId, userId])
}

model TopicSetting {
  id             String     @id @default(cuid())
  connectionId   String
  connection     Connection @relation(fields: [connectionId], references: [id])
  userId         String
  user           User       @relation(fields: [userId], references: [id])
  topicName      String
  comfortLevel   String
  isCustom       Boolean    @default(false)
  sanitizedLabel String?
  // Optional free-text refinement. E.g. for a Red "family" topic, a user can
  // write "specifically my mother-in-law" so the AI can distinguish from
  // other family subjects. Fed to the AI alongside the topic key/level.
  note           String?
  updatedAt      DateTime   @updatedAt
  createdAt      DateTime   @default(now())

  @@unique([connectionId, userId, topicName])
}

// A user's boundary answers from BEFORE any connection exists. Copied into
// per-connection TopicSetting rows the moment a connection activates, so
// boundaries are in force from the first message without a setup step the
// new pair could forget. Kept as its own model rather than a nullable
// TopicSetting.connectionId: Postgres allows many NULLs through a unique
// index, which would quietly permit duplicate default rows.
model TopicDefault {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  topicName      String
  comfortLevel   String
  isCustom       Boolean  @default(false)
  sanitizedLabel String?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@unique([userId, topicName])
}

// "Know Me" entries — each person shares bite-sized facts, preferences, and
// stories about themselves. Circle members can read them; the AI uses them to
// craft better rephrasings.
model KnowMeEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  category  String   // "favorites", "love_languages", "pet_peeves", "stories", "about_me"
  prompt    String   // the question or heading
  answer    String   // the user's answer
  isPublic  Boolean  @default(true) // visible to circle members
  // Connection IDs that can see this entry; empty = visible to all contacts.
  visibleTo String[]
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Practice Pad sessions — a safe space to rehearse difficult conversations
// with an AI partner before sending a real message.
model PracticeSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  topic     String   // what the user wants to practice talking about
  turns     String   // JSON array of {role, content} turns
  aiTip     String?  // AI-generated tip after the session
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Persisted application errors. Rows are deduplicated by fingerprint and
// counted, so an outage producing 500 identical failures is ONE row with
// count=500 rather than 500 rows nobody can read.
model LogEntry {
  id          String    @id @default(cuid())
  level       String // "warn" | "error" | "critical"
  source      String // logger name, e.g. "api.messages.compose"
  // The message TEMPLATE, with no varying data in it. Varying values belong in
  // `detail`, because anything interpolated here would break the fingerprint
  // and turn one recurring problem into thousands of distinct ones.
  message     String
  detail      String? // redacted context for this occurrence
  fingerprint String
  count       Int       @default(1)
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  alertedAt   DateTime? // last time an admin alert was sent for this fingerprint
  resolvedAt  DateTime?

  @@unique([fingerprint])
  @@index([lastSeenAt])
  @@index([level, lastSeenAt])
}

model Message {
  id               String     @id @default(cuid())
  senderId         String
  sender           User       @relation("Sender", fields: [senderId], references: [id])
  connectionId     String
  connection       Connection @relation(fields: [connectionId], references: [id])
  contentRaw       String
  contentRephrased String?
  versionSent      String?
  senderApproved   Boolean    @default(false)
  topicTags        String[]
  heldReason       String?
  aiProvider       String?
  aiModel          String?
  aiTokensUsed     Int?
  status           String     @default("draft")
  // Receiver's one-tap feedback, from a curated set. One per message,
  // changeable; the sender sees it on their Sent view.
  reaction         String?
  reactedAt        DateTime?
  readAt           DateTime?
  createdAt        DateTime   @default(now())
  sentAt           DateTime?
}

model WallPost {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  text      String
  mood      String?
  // Connection IDs that can see this post; empty = visible to all contacts.
  visibleTo String[]
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
