# Database
# Local macOS/Homebrew Postgres usually authenticates as your OS user with no
# password, e.g. postgresql://YOUR_OS_USERNAME@localhost:5432/leeway
# On Railway, reference the Postgres service: ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://REPLACE_USERNAME@localhost:5432/leeway"
TEST_DATABASE_URL="postgresql://REPLACE_USERNAME@localhost:5432/leeway_test"

# AI providers
# Tried in order. A provider with no API key is skipped, so you only need a key
# for the ones you actually use. An infrastructure failure (timeout, 429, 5xx)
# falls through to the next provider; a content refusal does NOT — see README.
#
# Default is Gemini (usable free tier) with Anthropic as backup. Reordering this
# line is the ONLY change needed to switch providers — no code edit, no redeploy
# of new code. Supported names: gemini, anthropic, openai.
AI_PROVIDER_CHAIN="gemini,anthropic"

# Google AI Studio -> API keys. Free tier is sufficient for a two-person app.
GEMINI_API_KEY=""
# Backup provider. Leave empty to run on Gemini alone.
ANTHROPIC_API_KEY=""
# Optional third provider.
OPENAI_API_KEY=""

# Model per provider. Check each provider's current model list before changing.
AI_MODEL_GEMINI="gemini-2.5-flash"
AI_MODEL_ANTHROPIC="claude-sonnet-4-5"
AI_MODEL_OPENAI="gpt-4o"
AI_MAX_TOKENS="1024"

# Optional: which provider grades AI quality tests. Prefer one NOT under test,
# so a provider never marks its own homework.
AI_JUDGE_PROVIDER=""

# Auth secrets — REQUIRED. The app throws rather than falling back to a default.
# Generate each separately:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-random-32-char-string"
MAGIC_LINK_SECRET="replace-with-a-DIFFERENT-random-string"

# Email (magic link delivery + admin alerts)
# With SMTP_HOST empty, mail is written to the server log instead of sent.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# Monitoring and admin
# ADMIN_TOKEN unlocks /admin (health findings, metrics, grouped error log).
# If it is unset the admin surface returns 503 — it never becomes public.
# Generate it like the auth secrets above.
ADMIN_TOKEN=""
# Where error alerts are emailed. Without it, errors are still recorded and
# visible in /admin, but nobody is notified.
ADMIN_EMAIL=""
# Set to "false" to record errors without emailing. Default is enabled.
ALERTS_ENABLED="true"
# Set to "false" to disable writing errors to the database entirely.
LOG_PERSISTENCE="true"

# App
# REQUIRED in production. Magic links are built from it; deriving the host from
# request headers instead would let an attacker send a victim a valid token
# pointing at their own domain.
BASE_URL="http://localhost:3000"
