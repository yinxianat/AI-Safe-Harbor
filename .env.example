# Database
# Local macOS/Homebrew Postgres usually authenticates as your OS user with no
# password, e.g. postgresql://YOUR_OS_USERNAME@localhost:5432/safeharbor
# On Railway, reference the Postgres service: ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://REPLACE_USERNAME@localhost:5432/safeharbor"
TEST_DATABASE_URL="postgresql://REPLACE_USERNAME@localhost:5432/safeharbor_test"

# AI providers
# The chain is tried in order; a provider with no key is skipped. An
# infrastructure failure falls through to the next provider, a content refusal
# does not. Switching providers needs no code change.
AI_PROVIDER_CHAIN="anthropic,openai"
ANTHROPIC_API_KEY="sk-ant-..."
OPENAI_API_KEY=""
AI_MODEL_ANTHROPIC="claude-sonnet-4-5"
AI_MODEL_OPENAI="gpt-4o"
AI_MAX_TOKENS="1024"

# Auth secrets — REQUIRED. The app throws rather than falling back to a default.
# Generate each separately:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-random-32-char-string"
MAGIC_LINK_SECRET="replace-with-a-DIFFERENT-random-string"

# Email (magic link delivery)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# App
# REQUIRED in production. Magic links are built from it; deriving the host from
# request headers instead would let an attacker send a victim a valid token
# pointing at their own domain.
BASE_URL="http://localhost:3000"
