# SafeHarbor .gitignore
#
# Contract: `git add -A` must stage everything needed to build and deploy,
# and must never stage a secret.
#
# Deliberately COMMITTED because Railway/Vercel need them at build time:
#   package.json, package-lock.json   dependency install
#   next.config.mjs                   Tailwind v4 turbopack loader
#   jsconfig.json                     the `@/*` import alias used across src/
#   prisma/schema.prisma              schema
#   prisma/migrations/**              `prisma migrate deploy` applies only what is committed
#   prisma7.config.ts                 Prisma 7 CLI config
#   railway.json, .nvmrc              deploy config + Node version pin
#   eslint.config.mjs, jest.config.js lint + test config
#   .env.example                      template, contains no real values
# Do not add a broad pattern that catches any of the above.

# ---------------------------------------------------------------------------
# Secrets — never commit. Keep this section first and widest.
# ---------------------------------------------------------------------------
# All env files are ignored; the committed template is re-included below.
.env
.env.*
!.env.example

# Keys, certificates, credentials
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
id_rsa
id_rsa.*
*.ppk
credentials.json
service-account*.json
secrets.json
secrets.yaml
secrets.yml
.netrc
.npmrc

# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
.next/
out/
/build/
/dist/
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------------------
# Generated code — recreated by `prisma generate` (runs in postinstall + build)
# ---------------------------------------------------------------------------
src/generated/

# ---------------------------------------------------------------------------
# Local database files (Postgres runs as a service; these are stray artifacts)
# ---------------------------------------------------------------------------
*.db
*.db-journal
*.sqlite
*.sqlite3

# ---------------------------------------------------------------------------
# Tests and coverage
# ---------------------------------------------------------------------------
/coverage/
/.nyc_output/

# ---------------------------------------------------------------------------
# Agent / AI tooling scaffolding
# `prisma init` auto-installs ~100 skill doc files. They are not needed to
# build, run, or deploy the app. Project-level .claude config stays committable.
# ---------------------------------------------------------------------------
/.agents/
/.windsurf/
/.cursor/
.claude/skills/
skills-lock.json

# ---------------------------------------------------------------------------
# Editor and OS
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
*.swp
*.swo
*~

# ---------------------------------------------------------------------------
# Logs and temp
# ---------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/logs/
/tmp/
/temp/
/.cache/

# ---------------------------------------------------------------------------
# Deploy platform local state
# ---------------------------------------------------------------------------
.vercel
.railway

# ---------------------------------------------------------------------------
# Internal planning and lessons documents
# These live in ../PLANS (outside this repo) and are deliberately NOT published.
# The patterns below are defensive: if the folder is ever copied or moved in
# here, `git add -A` must still not pick it up.
# ---------------------------------------------------------------------------
/PLANS/
/plans/
LESSONS.md
LESSONS.pdf
*-dev-plan.md
*-dev-plan.pdf
*-testing-plan.md
*-testing-plan.pdf
*-deployment-plan.md
*-deployment-plan.pdf

# Scratch / working notes
# NOTE: every directory pattern here is anchored with a leading slash. An
# unanchored `logs/` matches at ANY depth and silently excluded the
# src/app/api/admin/logs/ route — it built locally and vanished from the deploy.
/scratch/
/notes/
TODO.local.md
*.local.md
